{
  "name": "eclipse-dev-build",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMinZoomDistance": 8,
        "CameraMaxZoomDistance": 20
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [
            512,
            16,
            512
          ],
          "Position": [
            0,
            -8,
            0
          ],
          "Color": [
            0.36,
            0.55,
            0.27
          ],
          "Material": "Grass",
          "TopSurface": "Smooth",
          "Locked": true
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [
            8,
            1,
            8
          ],
          "Position": [
            0,
            0.5,
            0
          ],
          "Color": [
            0.95,
            0.8,
            0.4
          ],
          "TopSurface": "Smooth"
        }
      },
      "VerdantiaBlockout": {
        "$path": "map/VerdantiaBlockout.model.json"
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "OutdoorAmbient": [
          0.5,
          0.5,
          0.56
        ],
        "Ambient": [
          0.22,
          0.22,
          0.27
        ],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "Technology": "Future"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.25,
          "Color": [
            0.78,
            0.86,
            0.8
          ],
          "Decay": [
            0.45,
            0.56,
            0.5
          ],
          "Glare": 0.2,
          "Haze": 1.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.6
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.15,
          "Contrast": 0.08,
          "Brightness": 0.02,
          "TintColor": [
            1,
            1,
            1
          ]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.08,
          "Spread": 0.8
        }
      }
    }
  }
}
